# =============================================================================
# Backend environment variables — copy to .env.local and fill in real values.
# =============================================================================

# -----------------------------------------------------------------------------
# LiveKit (real-time transport)
# Get these from https://cloud.livekit.io/ → your project → Settings
# -----------------------------------------------------------------------------
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key_here
LIVEKIT_API_SECRET=your_livekit_api_secret_here

# -----------------------------------------------------------------------------
# Murf Falcon (TTS — Text-to-Speech)
# Get your API key from https://murf.ai/api/dashboard
# -----------------------------------------------------------------------------
MURF_API_KEY=your_murf_api_key_here

# Optional voice overrides. Defaults give Sehat Sathi an Indian English voice.
# Browse voices at https://murf.ai/api/docs/voices-styles/voice-library
# MURF_VOICE_ID=Anisha
# MURF_LOCALE=en-IN
# MURF_STYLE=Conversation

# -----------------------------------------------------------------------------
# Deepgram (STT — Speech-to-Text)
# Get your API key from https://deepgram.com
# -----------------------------------------------------------------------------
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# nova-3 in multilingual mode is what lets callers mix Hindi and English in one
# sentence. Set to "en" if you want English-only recognition.
# DEEPGRAM_LANGUAGE=multi

# -----------------------------------------------------------------------------
# LLM — use one of the following depending on which provider you use
# -----------------------------------------------------------------------------
# For Gemini (default): get from https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_api_key_here
# GOOGLE_LLM_MODEL=gemini-3.5-flash-lite

# -----------------------------------------------------------------------------
# Conversation behaviour (optional)
# -----------------------------------------------------------------------------
# Seconds of caller silence before the agent re-prompts. After a second silence
# it says goodbye and closes the call.
# SILENCE_TIMEOUT=10

# For OpenAI: get from https://platform.openai.com/api-keys (if using OpenAI LLM)
# OPENAI_API_KEY=your_openai_api_key_here

# --- Outbound calling (Day 6) -------------------------------------------------
# Which SIP provider the agent dials through. See scripts/setup_sip_trunk.py.
#
# `linphone` is the default and is free. Twilio's trial tier no longer lets you
# buy a phone number, so the agent calls a softphone over SIP instead: it dials
# sip:you@sip.linphone.org and the Linphone app rings. A real call over a real
# trunk, just not over the telephone network.
SIP_PROVIDER=linphone

# From your sip:<username>@sip.linphone.org address. Register free at
# https://subscribe.linphone.org/register/email
#
# In the Linphone app, turn OFF Settings > Calls > Advanced call settings >
# "Media encryption mandatory", or calls fail silently.
LINPHONE_USERNAME=

# Domain used to complete a bare username into a full SIP address.
SIP_DOMAIN=sip.linphone.org

# Only for SIP_PROVIDER=twilio, and only with a paid account. See the README for
# why this is a demo rather than a service in India: Twilio is not a
# TRAI-registered telemarketer.
TWILIO_SIP_ADDRESS=your-trunk.pstn.twilio.com
TWILIO_SIP_USERNAME=
TWILIO_SIP_PASSWORD=
SIP_CALLER_NUMBER=+1XXXXXXXXXX

# Printed by scripts/setup_sip_trunk.py once the trunk exists.
SIP_TRUNK_ID=

# Seconds to wait for a human to speak before hanging up without saying
# anything. Stands in for answering-machine detection, which SIP cannot do.
OUTBOUND_HUMAN_TIMEOUT=12

# Salts the do-not-call fingerprints. Set it to anything; changing it later
# empties the suppression list, so do not.
MEMORY_PHONE_SALT=

# --- Human help requests (Day 7) --------------------------------------------
# A request is always stored in local SQLite first. Email only notifies the
# human helper, so an SMTP failure cannot lose the request.
HUMAN_HELP_DB_PATH=data/human_help_requests.db

# Use a private test inbox. For Gmail, set both FROM and TO to your Gmail
# address, enable two-step verification, then create an App Password at
# https://myaccount.google.com/apppasswords. Never use your normal password.
HUMAN_HELP_EMAIL_TO=
HUMAN_HELP_EMAIL_FROM=
HUMAN_HELP_SMTP_PASSWORD=
HUMAN_HELP_SMTP_HOST=smtp.gmail.com
HUMAN_HELP_SMTP_PORT=465
